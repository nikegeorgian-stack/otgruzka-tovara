{
  "name": "fst-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sync:firestore-rules": "node scripts/sync-firestore-rules.mjs",
    "deploy:firestore-rules": "node scripts/sync-firestore-rules.mjs && firebase deploy --only firestore:rules,storage --project otgruzka-tovara",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project otgruzka-tovara",
    "migrate:cloud-store": "node scripts/normalize-cloud-store.mjs",
    "migrate:cloud-shards": "node scripts/migrate-cloud-shards.mjs",
    "export:cloud-backup": "node scripts/export-cloud-backup.mjs",
    "export:cloud-backup:admin": "node scripts/export-cloud-backup-admin.mjs",
    "import:cloud-backup": "node scripts/import-cloud-backup.mjs",
    "audit:cloud-store": "node scripts/audit-cloud-store.mjs",
    "clean:cloud-store": "node scripts/clean-cloud-store.mjs",
    "clean:cloud-store:apply": "node scripts/clean-cloud-store.mjs --apply",
    "migrate:sql-connect": "node scripts/migrate-firestore-to-sqlconnect.mjs",
    "deploy:dataconnect": "firebase deploy --only dataconnect --project otgruzka-tovara",
    "generate:dataconnect-sdk": "firebase dataconnect:sdk:generate --project otgruzka-tovara",
    "import:registry:cloud": "node scripts/import-registry-to-cloud.mjs",
    "apply:screenshot-salaries": "node scripts/apply-screenshot-salaries.mjs",
    "apply:roster-gap-june": "node scripts/apply-roster-gap-june.mjs",
    "migrate:firebase-project": "node scripts/migrate-firebase-project.mjs",
    "migrate:firebase-project:dry": "node scripts/migrate-firebase-project.mjs --dry-run",
    "switch:firebase-project": "node scripts/switch-firebase-project.mjs",
    "clear:hr-cloud": "node scripts/clear-hr-employees.mjs",
    "clear:hr-cloud:ps1": "powershell -ExecutionPolicy Bypass -File ../scripts/clear-hr-cloud.ps1",
    "reset-local": "node ../scripts/reset-local.mjs",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:android": "node ../scripts/build-android-apk.mjs",
    "build:apk": "node ../scripts/build-android-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@tanstack/react-virtual": "^3.14.5",
    "firebase": "^11.10.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
